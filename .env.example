# ArmorIQ platform API key (create at https://platform.armoriq.ai -> API Keys)
ARMORIQ_API_KEY=ak_live_xxx

# Optional: OpenRouter key so the LLM writes the plan instead of the demo planner
OPENROUTER_API_KEY=

# Optional: model id for the planner (default meta-llama/llama-3.3-70b-instruct:free)
PLANNER_MODEL=

# Optional: public URL of your running MCP server (ngrok/cloudflared), registered on ArmorIQ
MCP_PUBLIC_URL=
